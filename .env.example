# Core
NODE_ENV=development
TZ=America/Sao_Paulo

# Remote Ollama. Do not run Ollama in this compose project.
OLLAMA_BASE_URL=http://IP-DO-OLLAMA:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_API_KEY=ollama

# Backend
BACKEND_PORT=3000
BACKEND_HOST_PORT=13000
BACKEND_PUBLIC_URL=http://IP-DO-SERVIDOR:13000
BACKEND_API_KEY=change-me
TOOL_DEFAULT_TIMEOUT_MS=15000
ALLOWED_DOCKER_CONTAINERS=minecraft,homeassistant,open-webui
SAFE_SHELL_COMMANDS_JSON={"system_uptime":{"cmd":"uptime","args":[]},"disk_usage":{"cmd":"df","args":["-h"]}}

# TTS - OmniVoice
TTS_ENABLED=true
TTS_PROVIDER=omnivoice
TTS_AUDIO_STORAGE_PATH=/app/data/audio
TTS_PUBLIC_BASE_URL=http://IP-DO-SERVIDOR:13000
OMNIVOICE_BASE_URL=http://IP-DO-SERVIDOR-TTS:18001
OMNIVOICE_VOICE=pt-br-default
OMNIVOICE_INSTRUCT=female, natural, warm, low pitch
OMNIVOICE_SPEED=1.0
OMNIVOICE_FORMAT=wav

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=15432
POSTGRES_DB=ai_operator
POSTGRES_USER=ai_operator
POSTGRES_PASSWORD=change-me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=16379
REDIS_PASSWORD=

# Open WebUI
OPEN_WEBUI_PORT=8080
OPEN_WEBUI_HOST_PORT=18080
WEBUI_SECRET_KEY=change-me

# Home Assistant
HOME_ASSISTANT_PORT=8123
HOME_ASSISTANT_HOST_PORT=18123
HOME_ASSISTANT_URL=http://homeassistant:8123
HOME_ASSISTANT_TOKEN=replace-with-long-lived-token
GOOGLE_HOME_ENTITY_ID=media_player.google_home_mini

# Minecraft RCON
MINECRAFT_RCON_HOST=minecraft
MINECRAFT_RCON_PORT=25575
MINECRAFT_RCON_PASSWORD=change-me
